# Postgres ของเครื่อง — สร้างฐานข้อมูลด้วย: createdb ums_dev
# กำหนด username และ password เช่น: mysql://root:password@localhost:3306/ums_dev
DATABASE_URL=mysql://root:password@localhost:3306/ums_dev
AUTH_SECRET=change-me-32-bytes-base64
APP_URL=http://localhost:3010
# อีเมล (ว่าง = เขียนลง log แทน)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=App <no-reply@example.com>
# OAuth (ว่าง = ไม่แสดงปุ่ม)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
# production bootstrap (db:bootstrap)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# ต้นทาง Liyon (ค่าเริ่มต้น /Users/jira/Liyon-Theme/css)
LIYON_THEME_DIR=
# Gemini API Key (ว่าง = ใช้งาน Academic Heuristic Fallback Engine อัตโนมัติ)
GEMINI_API_KEY=
