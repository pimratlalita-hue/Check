# ==========================================
# GTMTS Production Environment Variables
# ==========================================

# Database Configuration (Used by docker-compose)
MYSQL_ROOT_PASSWORD=ChangeThisToAStrongRootPassword123!
MYSQL_DATABASE=ums_dev
MYSQL_USER=gtmts_user
MYSQL_PASSWORD=ChangeThisToAStrongUserPassword123!
MYSQL_PORT=3307

# Web Application Port Mapping (on Host)
APP_PORT=3010
APP_URL=http://localhost:3010

# NextAuth Secret (Generate with: openssl rand -hex 32)
AUTH_SECRET=e8f23b9d8819a843f5b72183c5e8c14a2f8b90123456789abcdef0123456
AUTH_TRUST_HOST=true

# Google Gemini API Key (Optional: leave blank for Academic Heuristic Fallback Engine)
GEMINI_API_KEY=

# Seed initial test data on startup (1 = enable, 0 = disable)
SEED_ON_INIT=1
