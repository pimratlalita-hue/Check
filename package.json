{
  "name": "vibe-framework",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "dev": "next dev -p 3010",
    "build": "next build --webpack",
    "start": "next start",
    "electron:start": "electron .",
    "electron:dev": "concurrently \"next dev -p 3010\" \"wait-on http://localhost:3010 && electron .\"",
    "electron:build:win": "electron-builder --win --x64",
    "electron:build:mac": "electron-builder --mac",
    "electron:dist": "electron-builder -mw",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "type-check:tests": "tsc --noEmit -p tsconfig.tests.json && tsc --noEmit -p e2e/tsconfig.json",
    "deps:check": "depcruise --config .dependency-cruiser.cjs src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "e2e:reset": "tsx scripts/e2e-reset.ts",
    "test:e2e": "npm run e2e:reset && npm run db:seed && playwright test",
    "check": "npm run type-check && npm run type-check:tests && npm run lint && npm run deps:check && npm run test && npm run test:integration",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:bootstrap": "tsx prisma/bootstrap.ts",
    "db:backup": "bash scripts/backup-database.sh",
    "sync:liyon": "tsx scripts/sync-liyon-theme.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@google/genai": "2.22.0",
    "@prisma/client": "6.19.3",
    "@tinymce/tinymce-react": "6.3.0",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.576.0",
    "next": "16.3.3",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "0.4.6",
    "nodemailer": "9.0.3",
    "radix-ui": "1.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.5.0",
    "tinymce": "8.9.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.5.2",
    "zustand": "5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.19.0",
    "@types/nodemailer": "7.0.11",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "6.0.0",
    "concurrently": "10.0.5",
    "dependency-cruiser": "16.10.4",
    "dotenv": "17.2.3",
    "electron": "34.5.8",
    "electron-builder": "25.1.8",
    "eslint": "9.39.0",
    "eslint-config-next": "16.1.6",
    "eslint-plugin-unused-imports": "4.4.1",
    "jsdom": "28.1.0",
    "prisma": "6.19.3",
    "shadcn": "3.8.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.0",
    "wait-on": "9.1.0"
  },
  "build": {
    "appId": "com.gtmts.app",
    "productName": "GTMTS",
    "copyright": "Copyright © 2026 MCU Faculty of Humanities",
    "nodeGypRebuild": false,
    "npmRebuild": false,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "package.json",
      "electron/**/*",
      "public/icons/**/*",
      "!node_modules/**/*",
      "!src/**/*",
      "!.next/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icons/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GTMTS"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/icons/icon.png",
      "category": "public.app-category.education"
    }
  }
}
